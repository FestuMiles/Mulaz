<%- include('partials/header') -%>

    <section class="item-section">
        <h1>
            Furniture Details
        </h1>
        <div class="container">
            <div class="image"><img src="<%= item.imageUrl %>" alt=""></div>
            <div class="desc">
                <h2><span>Product Name: </span><%= item.name %></h2>
                <p>
                    <span>Description:</span>

                    <%= item.desc %>
                </p>
                <h2><%= item.priceTag %></h2>
                <!-- <form action="/add-to-order" method="post">
                <label for="color">Choose a color:</label>
                <select name="color" id="color">
                    <option value="emerald-green">Emerald Green</option>
                    <option value="royal-blue">Royal Blue</option>
                    <option value="charcoal-gray">Charcoal Gray</option>
                    <option value="classic-beige">Classic Beige</option>
                </select>
                </form> -->
                <a href="/add-to-order/<%= objectsId %>" class="btn">Add to Order</a>
            </div>
        </div>
    </section>
    <input type="text" id="message" value="<%= message %>" hidden>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const inputValue = document.getElementById('message').value;
        if(inputValue !== 'none'){
            Swal.fire({
                title: 'Message',
                text: inputValue,
                icon: 'info',
                confirmButtonText: 'OK',
                confirmButtonColor: '#3085d6'
            });
        }
    </script>
    
    <%- include('partials/footer') -%>