<%- include('partials/header') -%>

    <section class="order-section">
        <h1>
            Oder Details
        </h1>
        <div class="container">
            <div class="items">
                <% let num = 0; %>
                <% furnitures.forEach((furniture)=>{ %>
                    <div>
                        <h2><%= furniture.name %></h2>
                        <div class="content">
                            <div class="image">
                                <img src="<%= furniture.imageUrl %>" alt="">
                            </div>
                            <div class="detail">
                                <p><%= furniture.desc %></p>
                                <a href="/remove-from-order/<%= list[num] %>" class="del">Remove</a>
                                <% num = num + 1 %>
                            </div>
                        </div>
                        <h3><%= furniture.priceTag %></h3>
                    </div>
                <% }) %>
            </div>
            <div class="summary">
                <h2>Summary</h2>
                <h3>Total Price: K<%= total %></h3>
                <form action="/submit-order" method="post">
                    <input type="text" name="name" id="name" placeholder="Enter your full names" required>
                    <input type="text" name="phone" placeholder="Enter your contact number">
                    <input type="email" placeholder="Enter email" name="email" required>
                    <input type="text" name="total" value="<%= total %>" hidden>
                    <button type="submit">Place Order</button>
                </form>
            </div>
        </div>
    </section>

    <script>
        const inputValue = document.getElementById('message').value;
        if(inputValue !== 'none'){
            alert(inputValue);
        }
    </script>
    <%- include('partials/footer') -%>
    